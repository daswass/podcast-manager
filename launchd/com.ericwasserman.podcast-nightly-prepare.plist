<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ericwasserman.podcast-nightly-prepare</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ericwasserman/workspace/podcast-manager/scripts/run-nightly-prepare.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ericwasserman/workspace/podcast-manager</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/podcast-nightly-prepare.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/podcast-nightly-prepare.err</string>
</dict>
</plist>

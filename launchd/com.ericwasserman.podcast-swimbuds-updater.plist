<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ericwasserman.podcast-swimbuds-updater</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ericwasserman/workspace/podcast-manager/scripts/run-on-swimbuds-mount.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ericwasserman/workspace/podcast-manager</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Fires when any volume is mounted or unmounted under /Volumes -->
    <key>WatchPaths</key>
    <array>
        <string>/Volumes</string>
    </array>

    <!-- Daily run at 6:40 AM local time if SWIMBUDS is mounted -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- Debounce rapid /Volumes changes (e.g. mount + Spotlight indexing) -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/tmp/podcast-swimbuds-launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/podcast-swimbuds-launchd.err</string>
</dict>
</plist>
